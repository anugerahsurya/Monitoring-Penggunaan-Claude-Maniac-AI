# Salin menjadi .env.local (lokal) atau isi di Vercel → Settings → Environment Variables
VITE_SUPABASE_URL=https://XXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=ISI_ANON_KEY_SUPABASE

# Batas default sebelum akun dikalibrasi lewat tombol Kalibrasi di dashboard
VITE_LIMIT_5H_TOKENS=1750000
VITE_LIMIT_WEEK_TOKENS=11000000
