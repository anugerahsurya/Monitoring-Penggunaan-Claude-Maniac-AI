# Salin menjadi .env.local (lokal) atau isi di Vercel → Settings → Environment Variables
VITE_SUPABASE_URL=https://XXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=ISI_ANON_KEY_SUPABASE

# Batas default untuk tim (bisa diubah tiap orang lewat tombol Pengaturan di dashboard)
VITE_LIMIT_5H_TOKENS=1000000
VITE_LIMIT_WEEK_TOKENS=10000000
